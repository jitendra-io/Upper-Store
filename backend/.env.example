# Server Configuration
PORT=5000
FRONTEND_URL=https://your-frontend.onrender.com

# Process-Level Load Balancing (Node.js Clustering)
# Set CLUSTER_MODE=true to enable multi-worker clustering across CPU cores
# In production, clustering auto-enables if multiple CPU cores are detected
CLUSTER_MODE=false
MAX_WORKERS=4

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id

# ImageKit Cloud Storage (for images and screenshots)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# GitHub Releases Integration (for direct hosting of large APK files)
GITHUB_REPO_OWNER=jitendra-io
GITHUB_REPO_NAME=Upper-Store
GITHUB_TOKEN=your_github_personal_access_token

# Cloudflare Edge Download Delivery (Zero-Cost, Zero-Server-Load Edge Streaming)
# Free Cloudflare Worker URL (e.g. https://upperstore-downloader.<username>.workers.dev or https://download.upperstore.io)
CLOUDFLARE_WORKER_URL=https://upperstore-downloader.your-subdomain.workers.dev
DOWNLOAD_SECRET_KEY=your_secure_download_secret_key_here

# Email / Contact Notification Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Google Gmail REST API (Priority 1: Port 443 HTTPS - Direct from Google with profile image)
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
GMAIL_USER=youremail@gmail.com

# Brevo HTTP REST API (Priority 2: Port 443 - Bypasses Render SMTP Blocks)
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
EMAIL_FROM_ADDRESS=youremail@gmail.com
EMAIL_FROM_NAME=Upper Store
